# =============================================================
# MySQL 8.4 - SQL 튜닝 실습용 설정
# 값을 바꾼 뒤 docker compose restart mysql 로 반영
# =============================================================
[mysqld]
# ---- InnoDB Buffer Pool (sysbench 실습 핵심) ----
innodb_buffer_pool_size = 1G        # 실습: 128M ~ 4G로 바꿔가며 hit ratio 관찰
innodb_buffer_pool_instances = 4

# ---- Redo Log (쓰기 성능 실습 핵심) ----
innodb_redo_log_capacity = 1G       # 실습: 100M로 줄이면 checkpoint 병목 관찰
innodb_flush_log_at_trx_commit = 1  # 실습: 2 또는 0으로 바꿔 fsync 비용 비교
innodb_flush_method = O_DIRECT

# ---- 락/동시성 ----
innodb_lock_wait_timeout = 10
transaction_isolation = REPEATABLE-READ   # 실습: READ-COMMITTED와 gap lock 비교

# ---- 모니터링 ----
performance_schema = ON
innodb_monitor_enable = all
slow_query_log = 1
long_query_time = 1
slow_query_log_file = /var/lib/mysql/slow.log

# ---- 로딩 성능 ----
local_infile = 1
max_allowed_packet = 256M

[client]
local_infile = 1
