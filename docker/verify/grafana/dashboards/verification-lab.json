      "datasource": {
        "type": "postgres",
        "uid": "verifylab-pg"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH latest AS (SELECT DISTINCT ON (category) category, run_id FROM verify_result WHERE trigger_kind NOT LIKE '%selected%' ORDER BY category, run_at DESC) SELECT round(100.0*count(*) FILTER (WHERE v.acceptable)/nullif(count(*),0),1) FROM verify_result v JOIN latest l ON v.category=l.category AND v.run_id=l.run_id WHERE v.category IN ($category)"
        }
      ]
    },
