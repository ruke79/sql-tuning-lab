      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH latest AS (SELECT DISTINCT ON (category) category, run_id FROM verify_result WHERE trigger_kind NOT LIKE '%selected%' ORDER BY category, run_at DESC) SELECT v.category, count(*) FILTER (WHERE verdict='CONFIRMED') AS confirmed, count(*) FILTER (WHERE verdict='REFUTED') AS refuted, count(*) FILTER (WHERE verdict='INCONCLUSIVE') AS inconclusive, count(*) FILTER (WHERE verdict='ERROR') AS error FROM verify_result v JOIN latest l ON v.category=l.category AND v.run_id=l.run_id WHERE v.category IN ($category) GROUP BY v.category ORDER BY v.category"
        }
      ]
    },
