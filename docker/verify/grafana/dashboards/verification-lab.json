    {
      "type": "stat",
      "title": "CONFIRMED",
      "id": 1,
      "description": "verify-lab 과 verify-lab-kafka 는 서로 다른 run_id 로 적재된다. 그래서 '최근 실행'을 run_id 하나가 아니라 분류별 최신 실행으로 정의한다 — 그러지 않으면 나중에 돌린 모듈만 보인다.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "postgres",
        "uid": "verifylab-pg"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH latest AS (SELECT DISTINCT ON (category) category, run_id FROM verify_result WHERE trigger_kind NOT LIKE '%selected%' ORDER BY category, run_at DESC) SELECT count(*) FROM verify_result v JOIN latest l ON v.category=l.category AND v.run_id=l.run_id WHERE v.category IN ($category) AND v.verdict='CONFIRMED'"
        }
