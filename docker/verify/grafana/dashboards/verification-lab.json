        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT min(run_at) AS time, round(100.0*count(*) FILTER (WHERE acceptable)/count(*),1) AS \"합격률\" FROM verify_result WHERE $__timeFilter(run_at) AND category IN ($category) GROUP BY run_id ORDER BY time"
        }
